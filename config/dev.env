# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
DB_URI=mongodb://127.0.0.1:27017/sat_nest

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES=7d

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="E-Commerce <no-reply@ecommerce.com>"
